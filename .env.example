# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
LOCAL_AUTH_BYPASS=false
DEBUG_ROUTES_ENABLED=false

# PostgreSQL / Prisma auth storage
DATABASE_URL=postgresql://user:password@localhost:5432/sas2py

# Databricks SQL operational storage
DATABRICKS_SERVER_HOSTNAME=adb-0000000000000000.0.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/0000000000000000
DATABRICKS_ACCESS_TOKEN=replace-with-databricks-token
DATABRICKS_CATALOG=sas2py
DATABRICKS_SCHEMA=prod

# Azure OpenAI via Azure AD / APIM
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=replace-with-azure-client-secret
APIM_SUBSCRIPTION_KEY=replace-with-apim-subscription-key
AZURE_OPENAI_SCOPE=https://cognitiveservices.azure.com/.default
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_MODEL=gpt5.5-dgw-default
AZURE_OPENAI_API_VERSION=2025-03-01-preview
OPENAI_TIMEOUT_MS=300000
OPENAI_CA_CERT_PATH=

# Optional Azure OpenAI model overrides
AZURE_OPENAI_MODEL_CONVERSION=
AZURE_OPENAI_MODEL_CONVERSION_FALLBACK=
AZURE_OPENAI_MODEL_ANALYSIS=
AZURE_OPENAI_MODEL_CONVERSATION=

# Databricks Jobs code execution
CODE_RUNNER_DATABRICKS_PYTHON_JOB_ID=
CODE_RUNNER_DATABRICKS_R_JOB_ID=
CODE_RUNNER_DATABRICKS_PYTHON_TASK_KEY=
CODE_RUNNER_DATABRICKS_R_TASK_KEY=
CODE_RUNNER_DATABRICKS_PYTHON_HOST=
CODE_RUNNER_DATABRICKS_PYTHON_TOKEN=
CODE_RUNNER_DATABRICKS_R_HOST=
CODE_RUNNER_DATABRICKS_R_TOKEN=
CODE_RUNNER_DATABRICKS_R_PACKAGES=
CODE_RUNNER_DATABRICKS_R_CRAN_REPO=

# Code execution limits and package policy
CODE_RUNNER_TIMEOUT_MS=120000
CODE_RUNNER_MAX_OUTPUT_CHARS=100000
CODE_RUNNER_DATABRICKS_INPUT_FILE_MAX_BYTES=256000
CODE_RUNNER_PACKAGE_POLICY=blocklist
CODE_RUNNER_PYTHON_BLOCKLIST=subprocess,socket,ctypes,multiprocessing,threading,urllib,http,requests,pip
CODE_RUNNER_R_BLOCKLIST=httr,curl,parallel,processx,sys,socket
CODE_RUNNER_PYTHON_ALLOWLIST=
CODE_RUNNER_R_ALLOWLIST=
CODE_RUNNER_MAX_ARTIFACT_BYTES=768000
CODE_RUNNER_MAX_ARTIFACT_TOTAL_BYTES=2000000
CODE_RUNNER_MAX_ARTIFACT_COUNT=10

# Optional Azure Blob handoff for large code/input payloads and artifacts
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=sas2py-inputs
AZURE_STORAGE_BLOB_PREFIX=execution-inputs
AZURE_STORAGE_DISABLE_SAS=false
